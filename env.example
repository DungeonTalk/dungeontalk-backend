# PostgreSQL Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/your_database_name
SPRING_DATASOURCE_USERNAME=your_db_username
SPRING_DATASOURCE_PASSWORD=your_secure_db_password
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver

# MongoDB Configuration
SPRING_DATA_MONGODB_HOST=localhost
SPRING_DATA_MONGODB_PORT=27017
SPRING_DATA_MONGODB_DATABASE=your_mongo_database
SPRING_DATA_MONGODB_USERNAME=your_mongo_username
SPRING_DATA_MONGODB_PASSWORD=your_mongo_password
SPRING_DATA_MONGODB_AUTHENTICATION_DATABASE=admin

# Redis/Valkey Configuration
SPRING_SESSION_STORE_TYPE=redis
SPRING_DATA_SESSION_HOST=localhost
SPRING_DATA_SESSION_PORT=6379
SPRING_CACHE_TYPE=redis
SPRING_REDIS_CACHE_HOST=localhost
SPRING_REDIS_CACHE_PORT=6379

# JPA Configuration
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_HIBERNATE_FORMAT_SQL=false

# JWT Configuration - IMPORTANT: Generate a secure secret key (minimum 256 bits)
JWT_SECRET=CHANGE_THIS_TO_A_VERY_LONG_SECURE_SECRET_KEY_AT_LEAST_32_CHARACTERS_OR_MORE
JWT_ACCESS_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000